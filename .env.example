# ---------------------------------------------------------------------------
# Resend email delivery
# ---------------------------------------------------------------------------
# RESEND_API_KEY: API key from https://resend.com/api-keys (starts with "re_").
RESEND_API_KEY="re_123456789"

# RESEND_FROM_EMAIL: Sender address. This MUST be on a domain you have verified
# in Resend (Domains -> Add Domain -> add the DNS records -> Verified).
# The default `onboarding@resend.dev` can ONLY deliver to the email address that
# owns the Resend account; every other recipient is rejected with a 403.
RESEND_FROM_EMAIL="Oscar Fan Vote <vote@yourverifieddomain.com>"

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# APP_SECRET: Signing key for admin sessions and email verification codes.
# REQUIRED in production. Serverless instances do not share memory, so a missing
# secret means each instance signs with a different key and every session breaks.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="replace-with-a-long-random-string"

# ADMIN_PASSWORD: Password for the admin control panel (defaults to oscar2026admin).
ADMIN_PASSWORD="oscar2026admin"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# GEMINI_API_KEY: Required only for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted.
APP_URL="MY_APP_URL"
